# Konfigurasi aplikasi BukuRumah
# Salin berkas ini menjadi .env lalu isi nilainya.
# Jangan pernah menaruh service role key di frontend atau di repository.

# URL proyek Supabase Anda, contoh: https://abcdefghij.supabase.co
VITE_SUPABASE_URL=

# Kunci anonim (public anon key). Aman dipakai di sisi klien selama RLS aktif.
VITE_SUPABASE_ANON_KEY=
